//

.jstree-default {
    .jstree-anchor {
        color: var(--kt-gray-700);
        padding: 0 8px 0 4px;
    }

    .jstree-icon {
        color: var(--kt-gray-700);

        font-size: 1.3rem;

        &.la {
            font-size: 1.5rem;
        }
        &.fa {
