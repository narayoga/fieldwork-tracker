    return { verticalAlign: "middle", width: `${val}vw` }
  }

  const getItem = async () => {
    const body = { page: "1" }
    const config = { headers: { Authorization: `Bearer ${token}` } };
    const url = `${process.env.REACT_APP_API_URL}admin/`;
    await axios.post(url, body, config)
      .then(res => {
        if (res.data instanceof Array) {
          setPosts(res.data)
          return
        }
        setWarning(true)
      })
      .catch(err => console.log(err))
  }

  const approve = (nama) => {
    const body = { username: nama }
      const config = { headers: { Authorization: `Bearer ${token}` } };
      const url = `${process.env.REACT_APP_API_URL}admin/approve/`;
