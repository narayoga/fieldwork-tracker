	const [mandor, setMandor] = useState('')

	const [warning, setWarning] = useState('')
	const token = localStorage.getItem('token')

	//submit
	const handleSubmit = async (e) => {
		e.preventDefault();
		setWarning('Loading...')
		const bodyUpdate = {
			subcon,
			manpower,
