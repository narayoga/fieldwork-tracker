    } 

    [data-kt-app-sidebar-collapse="on"] {
        .app-sidebar-collapse-d-none {
            display: none !important;    
        }

        .app-sidebar-collapse-d-flex {
            display: flex !important;    
        }
    }

    // Integration
    .app-sidebar {
        // Header
