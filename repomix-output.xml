  const filter = (param, param2) => {
    const result = posts.filter((item) => {
      if (param === '') {
        return result
      } else if (param2 !== '' && param !== '') {
        return item.status_microdemand === param && item.status_lop === param2
      } else {
        return item.status_microdemand === param || item.status_lop === param2
      }
    })
    setDisplay(result)
  }

